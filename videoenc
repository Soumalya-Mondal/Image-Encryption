
import os
import struct
import secrets
import getpass

from cryptography.hazmat.primitives.ciphers.aead import AESGCM
from cryptography.hazmat.primitives.kdf.argon2 import Argon2id


# ==========================================
# CONFIGURATION
# ==========================================

INPUT_FILE = "input.mp4"
ENCRYPTED_FILE = "encrypted_video.venc"
DECRYPTED_FILE = "decrypted_video.mp4"

CHUNK_SIZE = 10 * 1024 * 1024  # 10 MB

MAGIC = b"VENC002"
END_MARKER = 0xFFFFFFFFFFFFFFFF

# Argon2id configuration
SALT_SIZE = 32
KEY_SIZE = 32
NONCE_SIZE = 12
TAG_SIZE = 16

MEMORY_COST = 64 * 1024  # 64 MiB
ITERATIONS = 3
LANES = 4


# ==========================================
# PASSWORD INPUT
# ==========================================

PASSWORD = getpass.getpass("Enter encryption password: ")

if not PASSWORD:
    raise ValueError("Password cannot be empty")

PASSWORD_BYTES = PASSWORD.encode("utf-8")


# ==========================================
# STEP 1: ENCRYPTION
# ==========================================

print("\n========== ENCRYPTION STARTED ==========")

salt = secrets.token_bytes(SALT_SIZE)

kdf = Argon2id(
    salt=salt,
    length=KEY_SIZE,
    iterations=ITERATIONS,
    lanes=LANES,
    memory_cost=MEMORY_COST
)

key = kdf.derive(PASSWORD_BYTES)

aes = AESGCM(key)

chunk_index = 0
total_size = 0

temp_file = ENCRYPTED_FILE + ".tmp"

try:

    with open(INPUT_FILE, "rb") as source, \
         open(temp_file, "wb") as destination:

        # File header
        destination.write(MAGIC)
        destination.write(salt)

        while True:

            chunk = source.read(CHUNK_SIZE)

            if not chunk:
                break

            nonce = secrets.token_bytes(NONCE_SIZE)

            # Authenticate chunk metadata
            chunk_header = struct.pack(
                ">QI",
                chunk_index,
                len(chunk)
            )

            aad = MAGIC + salt + chunk_header

            encrypted_data = aes.encrypt(
                nonce,
                chunk,
                aad
            )

            # Write metadata
            destination.write(chunk_header)

            # Write unique nonce
            destination.write(nonce)

            # Write encrypted chunk and authentication tag
            destination.write(encrypted_data)

            chunk_index += 1
            total_size += len(chunk)

            print(f"Encrypted chunk: {chunk_index}")

        # ==================================
        # AUTHENTICATED FINAL MANIFEST
        # ==================================

        footer_header = struct.pack(
            ">QI",
            END_MARKER,
            0
        )

        footer_nonce = secrets.token_bytes(NONCE_SIZE)

        manifest = struct.pack(
            ">QQ",
            chunk_index,
            total_size
        )

        footer_aad = MAGIC + salt + b"END"

        encrypted_manifest = aes.encrypt(
            footer_nonce,
            manifest,
            footer_aad
        )

        destination.write(footer_header)
        destination.write(footer_nonce)
        destination.write(encrypted_manifest)

    os.replace(temp_file, ENCRYPTED_FILE)

except Exception:

    if os.path.exists(temp_file):
        os.remove(temp_file)

    raise

print("\n========== ENCRYPTION COMPLETED ==========")
print("Encrypted file:", ENCRYPTED_FILE)
print("Total chunks:", chunk_index)
print("Original size:", total_size, "bytes")


# ==========================================
# STEP 2: DECRYPTION
# ==========================================

print("\n========== DECRYPTION STARTED ==========")

decrypted_chunks = 0
decrypted_size = 0
footer_verified = False

temp_file = DECRYPTED_FILE + ".tmp"

try:

    with open(ENCRYPTED_FILE, "rb") as source, \
         open(temp_file, "wb") as destination:

        # Read file identifier
        magic = source.read(7)

        if magic != MAGIC:
            raise ValueError("Invalid VENC file")

        # Read salt
        salt = source.read(SALT_SIZE)

        if len(salt) != SALT_SIZE:
            raise ValueError("Invalid salt")

        # Derive the same encryption key
        kdf = Argon2id(
            salt=salt,
            length=KEY_SIZE,
            iterations=ITERATIONS,
            lanes=LANES,
            memory_cost=MEMORY_COST
        )

        key = kdf.derive(PASSWORD_BYTES)

        aes = AESGCM(key)

        while True:

            # Read chunk header
            header = source.read(12)

            if len(header) != 12:
                raise ValueError("Missing or incomplete final manifest")

            current_index, original_size = struct.unpack(
                ">QI",
                header
            )

            # ==================================
            # CHECK FINAL MANIFEST
            # ==================================

            if current_index == END_MARKER:

                if original_size != 0:
                    raise ValueError("Invalid manifest header")

                footer_nonce = source.read(NONCE_SIZE)

                if len(footer_nonce) != NONCE_SIZE:
                    raise ValueError("Incomplete manifest nonce")

                encrypted_manifest = source.read(32)

                if len(encrypted_manifest) != 32:
                    raise ValueError("Incomplete manifest")

                footer_aad = MAGIC + salt + b"END"

                manifest = aes.decrypt(
                    footer_nonce,
                    encrypted_manifest,
                    footer_aad
                )

                expected_chunks, expected_size = struct.unpack(
                    ">QQ",
                    manifest
                )

                if expected_chunks != decrypted_chunks:
                    raise ValueError("Chunk count verification failed")

                if expected_size != decrypted_size:
                    raise ValueError("File size verification failed")

                if source.read(1):
                    raise ValueError("Unexpected trailing data")

                footer_verified = True

                break

            # ==================================
            # DECRYPT NORMAL CHUNK
            # ==================================

            if current_index != decrypted_chunks:
                raise ValueError("Invalid chunk ordering")

            if not 1 <= original_size <= CHUNK_SIZE:
                raise ValueError("Invalid chunk size")

            nonce = source.read(NONCE_SIZE)

            if len(nonce) != NONCE_SIZE:
                raise ValueError("Incomplete nonce")

            encrypted_data = source.read(
                original_size + TAG_SIZE
            )

            if len(encrypted_data) != original_size + TAG_SIZE:
                raise ValueError("Incomplete encrypted chunk")

            aad = MAGIC + salt + header

            decrypted_data = aes.decrypt(
                nonce,
                encrypted_data,
                aad
            )

            destination.write(decrypted_data)

            decrypted_chunks += 1
            decrypted_size += len(decrypted_data)

            print(f"Decrypted chunk: {decrypted_chunks}")

    if not footer_verified:
        raise ValueError("Final manifest verification failed")

    os.replace(temp_file, DECRYPTED_FILE)

except Exception:

    if os.path.exists(temp_file):
        os.remove(temp_file)

    raise

print("\n========== DECRYPTION COMPLETED ==========")
print("Decrypted file:", DECRYPTED_FILE)
print("Total chunks:", decrypted_chunks)


# ==========================================
# STEP 3: FINAL VERIFICATION
# ==========================================

original_size = os.path.getsize(INPUT_FILE)
decrypted_size = os.path.getsize(DECRYPTED_FILE)

print("\n========== FINAL VERIFICATION ==========")

if original_size == decrypted_size and footer_verified:

    print("Original size:", original_size, "bytes")
    print("Decrypted size:", decrypted_size, "bytes")
    print("Manifest: VERIFIED")
    print("RESULT: SUCCESS")

else:

    print("RESULT: VERIFICATION FAILED")


# ==========================================
# CLEANUP
# ==========================================

del key
del PASSWORD_BYTES
del PASSWORD

print("\nPROCESS COMPLETED")